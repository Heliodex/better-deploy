# Local Versity Gateway bucket for production-like deploys (`bun run bucket`,
# then `bun run deploy:bucket`). Test credentials only — the gateway listens
# on localhost and the data lives in git-ignored `.celld/vgw/`.
# Override any of these with real environment variables.
CELLD_BUCKET=s3://celld
S3_ENDPOINT=http://127.0.0.1:10000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=testuser
AWS_SECRET_ACCESS_KEY=testsecret
