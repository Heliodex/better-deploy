{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "celld",
	"compatibility_date": "2026-10-21",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": "./build"
	},
	"kv_namespaces": [{ "binding": "GUESTBOOK", "id": "guestbook" }]
}
