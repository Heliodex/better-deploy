# Fleet bucket: s3://BUCKET[/PREFIX], gs://BUCKET or az://CONTAINER
CELLD_BUCKET=s3://your-bucket

# Endpoint for an S3-compatible store (R2, MinIO, ...).
# Leave unset for AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Region of the bucket. R2 uses "auto"; AWS uses the bucket's region.
AWS_REGION=us-east-1

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Only needed for temporary credentials.
# AWS_SESSION_TOKEN=
