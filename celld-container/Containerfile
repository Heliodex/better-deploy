# syntax=docker/dockerfile:1
#
# One container, two processes:
#
#   versitygw  S3 API over a local directory (the celld fleet bucket)
#   celld      one node, serving the bucket
#
# The application is not baked in. Deploy it into the bucket with `celld deploy` (from the host or another container) pointed at the published gateway port; the running node adopts the deployment within CELLD_DEPLOY_POLL_S seconds (30 by default), without a restart.
#
# See README.md for the run command and caveats.

FROM docker.io/library/debian:bookworm-slim

ARG CELLD_VERSION=v0.6.3
ARG VGW_VERSION=v1.9.0

# curl: downloading the binaries here, plus the health check and entrypoint.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# celld publishes gnu tarballs but no checksums file; provenance is the per-release build attestation:
#   gh attestation verify celld-x86_64-unknown-linux-gnu.gz --repo denoland/celld
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) celld_target=x86_64-unknown-linux-gnu; vgw_target=x86_64 ;; \
      arm64) celld_target=aarch64-unknown-linux-gnu; vgw_target=arm64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 -o /tmp/celld.gz \
      "https://github.com/denoland/celld/releases/download/${CELLD_VERSION}/celld-${celld_target}.gz"; \
    gzip -dc /tmp/celld.gz > /usr/local/bin/celld; \
    chmod 0755 /usr/local/bin/celld; \
    rm /tmp/celld.gz

# versitygw publishes checksums.txt next to each release, so verify the tarball.
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) vgw_target=x86_64 ;; \
      arm64) vgw_target=arm64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    vgw_asset="versitygw_${VGW_VERSION}_Linux_${vgw_target}.tar.gz"; \
    base="https://github.com/versity/versitygw/releases/download/${VGW_VERSION}"; \
    curl -fsSL --retry 3 -o "/tmp/$vgw_asset" "$base/$vgw_asset"; \
    curl -fsSL --retry 3 -o /tmp/vgw.checksums "$base/checksums.txt"; \
    (cd /tmp && grep " ${vgw_asset}\$" vgw.checksums | sha256sum -c -); \
    tar -xzf "/tmp/$vgw_asset" -C /tmp; \
    install -m 0755 "/tmp/versitygw_${VGW_VERSION}_Linux_${vgw_target}/versitygw" \
      /usr/local/bin/versitygw; \
    rm -rf "/tmp/$vgw_asset" /tmp/vgw.checksums "/tmp/versitygw_${VGW_VERSION}_Linux_${vgw_target}"

RUN groupadd --gid 1000 celld \
 && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin celld

# One volume holds everything that must survive the container:
#   s3/    versitygw's posix root (a directory per bucket)
#   iam/   versitygw's IAM state
#   work/  celld's local SQLite copies and replication state (CELLD_WATCH)
RUN install -d -o 1000 -g 1000 -m 0755 /var/lib/celld/s3 /var/lib/celld/iam /var/lib/celld/work

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=0755 healthcheck.sh /usr/local/bin/healthcheck.sh

USER 1000:1000

# 8080: celld's public Worker listener (the application)
# 10000: versitygw's S3 API, needed only for `celld deploy` from outside
# celld's internal peer/operator listener stays on 127.0.0.1:8081: it has no authentication and peer traffic is not encrypted, so never publish it.
EXPOSE 8080 10000

VOLUME ["/var/lib/celld"]

STOPSIGNAL SIGTERM
# celld bounds its own drain (`CELLD_SHUTDOWN_TOTAL_MS`, 40s default), so the runtime must give it at least that long: `podman run --stop-timeout 75`.
HEALTHCHECK --interval=10s --timeout=3s --start-period=90s --retries=6 \
  CMD ["/usr/local/bin/healthcheck.sh"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
