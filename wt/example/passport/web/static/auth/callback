<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8">
		<meta content="width=device-width, initial-scale=1" name="viewport">
		<meta content="noindex" name="robots">
		<title>Completing sign-in · Passport</title>
		<style>
			:root {
				--night: #14243c;
				--paper: #f2ebdc;
				--accent: #8c2f39;
				--accent-soft: #f2dedd;
				--muted: #6e6a5f;
			}
			body {
				display: grid;
				place-items: center;
				min-height: 100vh;
				margin: 0;
				background: var(--paper);
				color: var(--night);
				font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
				text-align: center;
			}
			main {
				max-width: 34rem;
				padding: 2rem;
			}
			.seal {
				display: grid;
				place-items: center;
				width: 62px;
				height: 62px;
				margin: 0 auto 1.4rem;
				border: 1px solid var(--accent);
				border-radius: 50%;
				background: var(--accent-soft);
				box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 5px rgb(140 47 57 / 35%);
				font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
				font-size: 1.3rem;
				color: var(--accent);
			}
			p {
				margin: 0.8rem 0 0;
				color: var(--muted);
				font-size: 0.9rem;
				line-height: 1.6;
			}
			h1 {
				margin: 0;
				font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
				font-size: clamp(1.7rem, 5vw, 2.4rem);
				font-weight: 500;
				letter-spacing: -0.02em;
				line-height: 1.1;
			}
		</style>
	</head>
	<body>
		<main>
			<div class="seal" aria-hidden="true">P</div>
			<h1>Checking your papers…</h1>
			<p>
				The one-time code is being exchanged on the server. The browser is about to receive an HttpOnly session cookie
				and return to the ledger.
			</p>
		</main>
		<script>
			const go = reason => {
				location.replace(reason === undefined ? "/" : `/?auth=${encodeURIComponent(reason)}`)
			}
			const params = new URLSearchParams(location.search)
			const code = params.get("code") ?? ""
			const state = params.get("state") ?? ""
			if (params.get("error") !== null) go("denied")
			else if (code === "" || state === "") go("failed")
			else
				void (async () => {
					try {
						const response = await fetch("/api/auth/callback", {
							body: JSON.stringify({ code, state }),
							credentials: "same-origin",
							headers: { "content-type": "application/json" },
							method: "POST",
						})
						if (response.ok) {
							go()
							return
						}
						const body = await response.json().catch(() => null)
						go(body?.code ?? "failed")
					} catch {
						go("failed")
					}
				})()
		</script>
	</body>
</html>
