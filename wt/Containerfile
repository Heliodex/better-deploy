# syntax=docker/dockerfile:1
#
# The wt runtime image: the supervisor plus a pinned wasmtime. Apps are
# uploaded later; the image contains no applications.

FROM docker.io/library/golang:1.27-alpine AS build
WORKDIR /src
RUN mkdir -p /out
COPY wt/supervisor/go.mod wt/supervisor/go.sum ./
RUN go mod download
COPY wt/supervisor/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/wt-supervisor .

FROM docker.io/library/debian:bookworm-slim AS wasmtime

ARG WASMTIME_VERSION=v50.0.0

RUN mkdir -p /out
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Wasmtime's Linux builds link glibc, so the runtime stage is Debian rather
# than Alpine. The version must match the one wt-deploy uses to precompile.
RUN set -eux; \
    arch="x86_64"; \
    asset="wasmtime-${WASMTIME_VERSION}-${arch}-linux.tar.xz"; \
    base="https://github.com/bytecodealliance/wasmtime/releases/download/${WASMTIME_VERSION}"; \
    curl -fsSL --retry 3 -o "/tmp/${asset}" "${base}/${asset}"; \
    tar -xJf "/tmp/${asset}" -C /tmp; \
    install -m 0755 "/tmp/wasmtime-${WASMTIME_VERSION}-${arch}-linux/wasmtime" /out/wasmtime

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /var/lib/wt/apps /var/lib/wt/state

COPY --from=build /out/wt-supervisor /usr/local/bin/wt-supervisor
COPY --from=wasmtime /out/wasmtime /usr/local/bin/wasmtime

ENV WT_APPS_DIR=/var/lib/wt/apps \
    WT_STATE_DIR=/var/lib/wt/state \
    WT_LISTEN=0.0.0.0:8080 \
    WT_WASMTIME=/usr/local/bin/wasmtime \
    WT_APPS_DOMAIN=localhost

EXPOSE 8080
VOLUME ["/var/lib/wt"]

ENTRYPOINT ["/usr/local/bin/wt-supervisor"]
