# syntax=docker/dockerfile:1
#
# The wt runtime image: a runtime-only wasmtime and the supervisor. Apps are uploaded later; the image contains no applications.

FROM golang:1-alpine AS supervisor
WORKDIR /src
RUN mkdir -p /out
COPY --from=docker.io/oven/bun:alpine /usr/local/bin/bun /usr/local/bin/bun
RUN apk add --no-cache libstdc++ libgcc
COPY wt/supervisor/go.mod wt/supervisor/go.sum ./
RUN go mod download
COPY wt/supervisor/ ./
RUN go generate ./... && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/wt-supervisor .

# Build wasmtime without Cranelift/Winch: the serving side only deserializes the .cwasm files produced by wt-deploy. The musl build is fully static, so the final image can be scratch.
FROM rust:1-slim AS wasmtime

ARG WASMTIME_VERSION=v50.0.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential cmake pkg-config curl ca-certificates xz-utils binutils musl-tools \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-musl

WORKDIR /src
RUN curl -fsSL "https://github.com/bytecodealliance/wasmtime/archive/refs/tags/${WASMTIME_VERSION}.tar.gz" | tar -xz
WORKDIR /src/wasmtime-50.0.0
RUN cargo build --release --locked --target x86_64-unknown-linux-musl --bin wasmtime --no-default-features \
    --features "serve,run,component-model-async,pooling-allocator,threads,gc,gc-drc,gc-null,gc-copying,stack-switching,logging,clap/default,clap/wrap_help"
RUN strip -s target/x86_64-unknown-linux-musl/release/wasmtime

FROM scratch

COPY --from=wasmtime /src/wasmtime-50.0.0/target/x86_64-unknown-linux-musl/release/wasmtime /usr/local/bin/wasmtime
COPY --from=wasmtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=supervisor /out/wt-supervisor /usr/local/bin/wt-supervisor

ENV WT_APPS_DIR=/var/lib/wt/apps \
    WT_STATE_DIR=/var/lib/wt/state \
    WT_LISTEN=0.0.0.0:8080 \
    WT_WASMTIME=/usr/local/bin/wasmtime \
    WT_WASMTIME_TARGET=x86_64-unknown-linux-musl \
    WT_APPS_DOMAIN=localhost \
    TMPDIR=/var/lib/wt

WORKDIR /var/lib/wt
EXPOSE 8080
VOLUME ["/var/lib/wt"]

ENTRYPOINT ["/usr/local/bin/wt-supervisor"]
