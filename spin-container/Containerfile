# syntax=docker/dockerfile:1
#
# A multi-app Spin runtime. The supervisor starts one `spin up` process per
# application, writes a Caddy config that routes each hostname to the app's
# loopback port, and serves the deploy API. Applications and their state live
# under /var/lib/spin, so the image contains no application.
#
# See README.md for the layout, deploy command and environment.

FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.24-alpine AS supervisor
ARG TARGETARCH
WORKDIR /src
COPY supervisor/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/supervisor .

FROM docker.io/library/alpine:3.24 AS fetch

ARG SPIN_VERSION=v4.2.5
ARG TARGETARCH

# Build-only tools: curl for the download, binutils to strip the binary,
# ca-certificates for TLS. None of this reaches the final image.
RUN apk add --no-cache binutils ca-certificates curl

# Spin publishes a static Linux build, so the runtime image can be Alpine rather
# than carrying a glibc base. The tarball is large because the CLI embeds
# Wasmtime; stripping removes about 50 MB of symbols from the ~163 MB binary.
# Checksums are published next to each release, so verify the asset.
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) arch=amd64 ;; \
      arm64) arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    asset="spin-${SPIN_VERSION}-static-linux-${arch}.tar.gz"; \
    base="https://github.com/spinframework/spin/releases/download/${SPIN_VERSION}"; \
    curl -fsSL --retry 3 -o "/tmp/$asset" "$base/$asset"; \
    curl -fsSL --retry 3 -o /tmp/checksums.txt "$base/checksums-${SPIN_VERSION}.txt"; \
    sum=$(grep " $asset\$" /tmp/checksums.txt) || { echo "no checksum for $asset" >&2; exit 1; }; \
    printf '%s\n' "$sum" | (cd /tmp && sha256sum -c -); \
    tar -xzf "/tmp/$asset" -C /tmp spin; \
    strip -s /tmp/spin; \
    mkdir -p /out; \
    install -m 0755 /tmp/spin /out/spin; \
    rm -rf "/tmp/$asset" /tmp/checksums.txt

FROM docker.io/library/alpine:3.24

# ca-certificates: outbound HTTPS from components.
# su-exec: drop from root once a mounted volume has been handed to uid 1000.
# caddy: the public listener and hostname routing.
RUN apk add --no-cache ca-certificates su-exec caddy tini \
 && addgroup -g 1000 spin \
 && adduser -D -u 1000 -G spin -h /var/lib/spin/home -H -s /sbin/nologin spin \
 && install -d -o 1000 -g 1000 -m 0750 \
      /var/lib/spin/home \
      /var/lib/spin/tmp \
      /var/lib/spin/apps \
      /var/lib/spin/state \
      /var/lib/spin/logs \
      /var/lib/spin/cache \
      /var/lib/spin/caddy/data \
      /var/lib/spin/caddy/config

COPY --from=fetch --chmod=0755 /out/spin /usr/local/bin/spin
COPY --from=supervisor --chmod=0755 /out/supervisor /usr/local/bin/supervisor
COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh

# HOME holds Wasmtime's compiled-module cache. TMPDIR and the Caddy XDG paths
# live on the volume, so a read-only root filesystem still works.
ENV HOME=/var/lib/spin/home \
    TMPDIR=/var/lib/spin/tmp \
    XDG_DATA_HOME=/var/lib/spin/caddy/data \
    XDG_CONFIG_HOME=/var/lib/spin/caddy/config \
    SPIN_APPS_DIR=/var/lib/spin/apps \
    SPIN_STATE_DIR=/var/lib/spin/state \
    SPIN_LOG_DIR=/var/lib/spin/logs \
    SPIN_CACHE_DIR=/var/lib/spin/cache \
    SPIN_TMP_DIR=/var/lib/spin/tmp \
    CADDY_CONFIG=/var/lib/spin/caddy/Caddyfile \
    CADDY_CONFIG_DIR=/var/lib/spin/caddy/config \
    CADDY_DATA_DIR=/var/lib/spin/caddy/data \
    CADDY_ADMIN=127.0.0.1:2019 \
    LISTEN=0.0.0.0:8080 \
    API_LISTEN=127.0.0.1:9090

# 8080: Caddy, the only published port. The deploy API is proxied through it
# when DEPLOY_HOST is set; otherwise it stays on loopback.
EXPOSE 8080

# Everything that must survive the container: app bundles, KV/SQLite state,
# logs, the Spin cache and the generated Caddy config.
VOLUME ["/var/lib/spin"]

STOPSIGNAL SIGTERM

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/entrypoint.sh"]
